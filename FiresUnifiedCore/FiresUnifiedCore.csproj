  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
  <!-- Post-build deploy to the active r2modman 'BlueHills' test profile. Gated on
       Exists so a missing/renamed profile (other machines, CI) just skips and never
       fails the build. Copies only the built DLL + PDB into the existing r2modman-
       managed mod folder; other files there (LiteDB, etc.) are left untouched. -->
  <PropertyGroup>
    <BlueHillsPluginDir>$(AppData)\r2modmanPlus-local\Valheim\profiles\BlueHills\BepInEx\plugins\FiresUnifiedCore\</BlueHillsPluginDir>
    <BlueHillsDediDir>C:\Program Files (x86)\Steam\steamapps\common\Valheim dedicated server - BlueHills\BepInEx\plugins\FiresUnifiedCore\</BlueHillsDediDir>
  </PropertyGroup>
  <Target Name="DeployToBlueHills" AfterTargets="Build" Condition="Exists('$(BlueHillsPluginDir)')">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(BlueHillsPluginDir)" OverwriteReadOnlyFiles="true" />
    <Copy SourceFiles="$(TargetDir)$(TargetName).pdb" DestinationFolder="$(BlueHillsPluginDir)" OverwriteReadOnlyFiles="true" Condition="Exists('$(TargetDir)$(TargetName).pdb')" />
    <Message Importance="high" Text="Deployed $(TargetFileName) (+pdb) -> $(BlueHillsPluginDir)" />
  </Target>
  <Target Name="DeployToBlueHillsDedi" AfterTargets="Build" Condition="Exists('$(BlueHillsDediDir)')">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(BlueHillsDediDir)" OverwriteReadOnlyFiles="true" />
    <Message Importance="high" Text="Deployed $(TargetFileName) -> $(BlueHillsDediDir)" />
  </Target>
  <!-- The plain dedi receives FiresRPGmaker on every deploy; without Core alongside it, the pair
       skews and new Core APIs MissingMethod-crash there (parity plan bug B5). -->
  <PropertyGroup>
    <PlainDediDir>C:\Program Files (x86)\Steam\steamapps\common\Valheim dedicated server\BepInEx\plugins\</PlainDediDir>
  </PropertyGroup>
  <Target Name="DeployToPlainDedi" AfterTargets="Build" Condition="Exists('$(PlainDediDir)')">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PlainDediDir)" OverwriteReadOnlyFiles="true" />
    <Message Importance="high" Text="Deployed $(TargetFileName) -> $(PlainDediDir)" />
  </Target>
</Project>